   "text": "```python\n\"\"\"\nThread-safe LRU cache with per-entry TTL.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport threading\nimport time\nfrom collections import OrderedDict\nfrom typing import Any, Generic, Hashable, Optional, TypeVar\n\nK = TypeVar(\"K\", bound=Hashable)\nV = TypeVar(\"V\")\n\n\nclass LRUCache(Generic[K, V]):\n    \"\"\"\n    A thread-safe LRU cache with per-entry TTL (time-to-live).\n\n    Each entry can have its own TTL. When an entry expires, it is treated as\n    a cache miss. The cache evicts the least recently used entry when it is\n    full.\n\n    Thread safety is ensured via a reentrant lock.\n    \"\"\"\n\n    def __init__(self, maxsize: int = 128, default_ttl: Optional[float] = None) -> None:\n        \"\"\"\n        Initialize the LRU cache.\n\n        Args:\n            maxsize: Maximum number of entries in the cache.\n            default_ttl: Default TTL in seconds for entries. None means no expiry.\n        \"\"\"\n        if maxsize <= 0:\n            raise ValueError(\"maxsize must be positive\")\n        self._maxsize = maxsize\n        self._default_ttl = default_ttl\n        self._cache: OrderedDict[K, tuple[V, Optional[float]]] = OrderedDict()\n        self._lock = threading.RLock()\n\n    def get(self, key: K, default: Any = None) -> Any:\n        \"\"\"\n        Get a value from the cache.\n\n        Args:\n            key: The key to look up.\n            default: Value to return if key is not found or expired.\n\n        Returns:\n            The cached value, or default if not found/expired.\n        \"\"\"\n        with self._lock:\n            if key not in self._cache:\n                return default\n            value, expiry = self._cache[key]\n            # Check if expired\n            if expiry is not None and time.monotonic() > expiry:\n                del self._cache[key]\n                return default\n            # Move to end (most recently used)\n            self._cache.move_to_end(key)\n            return value\n\n    def put(self, key: K, value: V, ttl: Optional[float] = None) -> None:\n        \"\"\"\n        Put a value into the cache.",
