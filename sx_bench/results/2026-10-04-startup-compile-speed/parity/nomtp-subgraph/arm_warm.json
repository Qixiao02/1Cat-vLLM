   "text": "```python\n\"\"\"\nThread-safe LRU Cache with per-entry TTL.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport threading\nimport time\nfrom collections import OrderedDict\nfrom typing import Any, Generic, TypeVar, Optional\n\nK = TypeVar(\"K\")\nV = TypeVar(\"V\")\n\n\nclass LRUCache(Generic[K, V]):\n    \"\"\"\n    A thread-safe LRU cache with per-entry TTL (time-to-live).\n\n    Each entry can have its own TTL. When an entry expires, it is treated as\n    a cache miss. The cache evicts the least recently used entry when it is\n    full.\n\n    Thread safety is ensured via a reentrant lock.\n    \"\"\"\n\n    def __init__(self, capacity: int, default_ttl: Optional[float] = None) -> None:\n        \"\"\"\n        Initialize the LRU cache.\n\n        Args:\n            capacity: Maximum number of entries in the cache.\n            default_ttl: Default TTL in seconds for entries. If None, entries\n                         do not expire by default.\n        \"\"\"\n        if capacity <= 0:\n            raise ValueError(\"Capacity must be a positive integer\")\n        self._capacity = capacity\n        self._default_ttl = default_ttl\n        self._cache: OrderedDict[K, tuple[V, Optional[float]]] = OrderedDict()\n        self._lock = threading.RLock()\n\n    def get(self, key: K) -> Optional[V]:\n        \"\"\"\n        Get the value for the given key.\n\n        Args:\n            key: The key to look up.\n\n        Returns:\n            The cached value if present and not expired, None otherwise.\n        \"\"\"\n        with self._lock:\n            if key not in self._cache:\n                return None\n\n            value, expires_at = self._cache[key]\n\n            # Check if the entry has expired\n            if expires_at is not None and time.monotonic() > expires_at:\n                # Remove the expired entry\n                del self._cache[key]\n                return None\n\n            # Move to end (most recently used)\n            self._cache.move_to_end(key)\n            return value\n\n    def put(self, key: K, value: V, ttl: Optional[float] = None) -> None:\n        \"\"\"\n        Put a value into the cache.\n\n        Args:\n            key: The key to store.\n            value",
